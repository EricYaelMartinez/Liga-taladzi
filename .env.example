APP_NAME="ProLiga"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=liga_taladzi
DB_USERNAME=liga_user
DB_PASSWORD=liga_local_password
DB_TIMEZONE=America/Mexico_City

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3660
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

BACKUP_DIRECTORY=backups
BACKUP_RETENTION_COUNT=8
BACKUP_SCHEDULE_DAY=sunday
BACKUP_SCHEDULE_TIME=03:00

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@proliga.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
